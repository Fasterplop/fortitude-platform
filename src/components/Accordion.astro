---
interface Props {
  title: string;
  details: string;
}

const { title, details } = Astro.props;
---

<details class="group bg-white dark:bg-white/5 rounded-xl border border-gray-100 dark:border-white/10 overflow-hidden transition-all duration-300 hover:border-primary/40">
  <summary class="flex cursor-pointer items-center justify-between p-6 text-text-main dark:text-white font-serif font-bold text-lg select-none">
    {title}
    <span class="ml-4 flex-shrink-0 transition-transform duration-300 group-open:rotate-180 text-primary">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
    </span>
  </summary>
  <div class="px-6 pb-6 pt-2">
    <p class="text-gray-600 dark:text-gray-300 leading-relaxed border-l-2 border-primary/30 pl-4">
      {details}
    </p>
  </div>
</details>
---
interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const t = {
  en: {
    heading: 'Working with the best carriers'
  },
  es: {
    heading: 'Trabajamos con las mejores aseguradoras'
  }
}[lang === 'es' ? 'es' : 'en'];

// AÑADIDO: Propiedad 'darkInvert' para controlar individualmente cada logo
const carriers = [

  { name: 'Progressive', src: '/images/carriers/Progressive.png', darkInvert: false },
  { name: 'Geico', src: '/images/carriers/Geico.png', darkInvert: false },
  { name: 'Mile Auto', src: '/images/carriers/MileAuto.png', darkInvert: false },
  { name: 'National General', src: '/images/carriers/NationalGeneral.png', darkInvert: false },
  { name: 'Bristol West', src: '/images/carriers/Bristol.png', darkInvert: false },
  { name: 'Assurance America', src: '/images/carriers/AssuranceAmerica.png', darkInvert: false },
  { name: 'AmericanIntegrity', src: '/images/carriers/AmericanIntegrity.png', darkInvert: false },
  { name: 'Coterie', src: '/images/carriers/Coterie.png', darkInvert: true },
  { name: 'Embark', src: '/images/carriers/Embark.png', darkInvert: true },
 
  { name: 'Monarch', src: '/images/carriers/monarch.png', darkInvert: false },
  { name: 'TheGeneral', src: '/images/carriers/TheGeneral.png', darkInvert: true },
];
---

<section class="py-12 bg-transparent overflow-hidden border-b border-gray-100 dark:border-gray-800 pointer-events-none select-none">
  <div class="container mx-auto px-4 mb-8">
     <p class="text-center text-xs font-bold text-gray-400 uppercase tracking-[0.2em]">
      {t.heading}
    </p>
  </div>
  
  <div class="relative w-full">
    {/* Ajuste de degradados para coincidir con el fondo #151515 del Hero */}
    <div class="absolute inset-y-0 left-0 w-24 bg-gradient-to-r from-white dark:from-[#151515] to-transparent z-10"></div>
    <div class="absolute inset-y-0 right-0 w-24 bg-gradient-to-l from-white dark:from-[#151515] to-transparent z-10"></div>

    <div class="flex w-max animate-infinite-scroll">
      {/* BLOQUE 1 */}
      <div class="flex gap-20 mx-10 items-center">
    
        {carriers.map((carrier) => (
          <div class="w-44 h-28 flex items-center justify-center">
            <img 
              src={carrier.src} 
              alt={carrier.name} 
            
              class={`max-w-full max-h-full object-contain transition-all duration-300 ${carrier.darkInvert ? 'dark:brightness-0 dark:invert' : ''}`} 
            />
          </div>
        ))}
      </div>
      
      {/* BLOQUE 2 (Duplicado para el efecto infinito) */}
      <div class="flex gap-20 mx-10 items-center">
        {carriers.map((carrier) => (
          <div class="w-44 h-28 flex items-center justify-center">
     
             <img 
              src={carrier.src} 
              alt={carrier.name} 
              class={`max-w-full max-h-full object-contain transition-all duration-300 ${carrier.darkInvert ? 'dark:brightness-0 dark:invert' : ''}`} 
            />
          </div>
        ))}
      </div>
 
    </div>
  </div>
</section>

<style>
  @keyframes infinite-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  .animate-infinite-scroll {
    animation: infinite-scroll 40s linear infinite;
  }
</style>
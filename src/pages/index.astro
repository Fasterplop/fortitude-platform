---
import Layout from '../layouts/Layout.astro';
import CarriersCarousel from '../components/CarriersCarousel.astro';
import { Image } from 'astro:assets';
import autoImg from '../images/auto.jpg';
import propertyImg from '../images/property.jpg';
import commercialImg from '../images/commercial.jpg';
import healthImg from '../images/health.jpg';
import liabilityImg from '../images/liability.avif';
import rentersImg from '../images/renters.jpg';
import motorcycleImg from '../images/motorcycle.jpg';
import boatImg from '../images/boat.avif';
import rvImg from '../images/rv.jpg';

const title = "Fortitude Insurance Services LLC | Auto, Home & Commercial Insurance";
const description = "Quote in real time. Reliable insurance in Florida and Texas.";
// Definimos el idioma de esta página
const lang = "en";
---

<Layout title={title} description={description} lang={lang}>
  
  {/* === HERO SECTION (Limpio, sin Grid) === */}
  <section class="relative min-h-[90vh] flex flex-col justify-center overflow-hidden bg-surface-light dark:bg-surface-dark pt-20 pb-10">
    
    {/* Fondo sutil degradado solo para dar volumen, muy suave */}
    <div class="absolute inset-0 bg-gradient-to-b from-white via-white to-gray-50/50 dark:from-surface-dark dark:via-surface-dark dark:to-[#151515] pointer-events-none"></div>

    <div class="container mx-auto px-4 relative z-10 text-center flex-1 flex flex-col justify-center">
      
      {/* Main Title */}
      <h1 class="text-5xl md:text-7xl lg:text-8xl font-serif font-bold text-text-main dark:text-surface-light tracking-tight leading-[1.1] mb-6">
        Quote and insure <br/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary via-yellow-500 to-yellow-600">in just minutes</span>.
      </h1>

      {/* Subtitle */}
      <p class="text-xl md:text-2xl text-gray-600 dark:text-gray-300 max-w-4xl mx-auto mb-10 font-light leading-relaxed">
        With Fortitude Insurance get comprehensive protection for your auto, home, or business in Florida and Texas with real-time technology and expert support.
      </p>

      {/* Action Buttons */}
      <div class="flex flex-col sm:flex-row items-center justify-center gap-6 mb-8">
        <button id="open-quote-modal" class="group relative px-10 py-5 bg-text-main dark:bg-white text-white dark:text-black font-bold text-lg rounded-full hover:-translate-y-1 transition-all duration-300 overflow-hidden min-w-[220px]">
            <span class="relative z-10 flex items-center justify-center gap-3">
               Start Quote
               <svg class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </span>
            <div class="absolute inset-0 -translate-x-full group-hover:translate-x-full transition-transform duration-700 bg-gradient-to-r from-transparent via-white/20 to-transparent"></div>
        </button>
        
        <a href="/contact" class="text-gray-600 dark:text-gray-300 font-medium hover:text-primary transition-colors flex items-center gap-2 px-6 py-4 rounded-full hover:bg-gray-100 dark:hover:bg-white/10">
           Speak with an Agent
        </a>
      </div>

      {/* UX Microcopy (Trust & Speed) */}
      <p class="text-xs md:text-sm text-gray-500 dark:text-gray-400 font-medium mb-12 flex items-center justify-center gap-2 opacity-90">
         <span>⏱️ Quote in just 3 to 5 minutes.</span>
         <span class="hidden sm:inline">•</span>
         <span>This process is free and does not affect your credit score.</span>
      </p>

      {/* INTEGRATED CARRIERS CAROUSEL IN HERO */}
      <div class="w-full mx-auto border-t border-gray-200/50 dark:border-white/5 pt-0 md:pt-8">
          <CarriersCarousel lang={lang} />
      </div>

    </div>
</section>

  {/* === QUOTE MODAL === */}
  <div id="quote-modal" class="fixed inset-0 z-[100] hidden opacity-0 transition-opacity duration-300" aria-hidden="true">
      {/* Backdrop */}
      <div class="absolute inset-0 bg-black/80 backdrop-blur-md" id="modal-backdrop"></div>
  
      <div class="relative z-10 w-full h-full flex items-center justify-center p-4 md:p-8">
          <div class="bg-white w-full max-w-7xl h-[90vh] rounded-2xl overflow-hidden shadow-2xl flex flex-col relative animate-scale-in ring-1 ring-white/20">
              
              {/* Modal Header */}
              <div class="bg-surface-light dark:bg-surface-light px-6 py-4 border-b border-gray-200 flex items-center justify-between shadow-sm z-20">
                  <div class="flex items-center gap-4">
                      <img src="/images/fortitude-logo.png" alt="Fortitude Insurance" class="h-10 w-auto object-contain" />
                      <div class="hidden sm:block">
                          <h3 class="font-bold text-gray-900 text-lg leading-tight">Fortitude Insurance</h3>
                          <p class="text-xs text-gray-500 font-medium tracking-wide uppercase flex items-center gap-1.5">
                              <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
                              Official Quoting Platform
                          </p>
                      </div>
                  </div>
                  <button id="close-modal-btn" class="group p-2 hover:bg-gray-100 rounded-full transition-colors text-gray-400 hover:text-red-500">
                      <svg class="w-6 h-6 transform group-hover:rotate-90 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                  </button>
              </div>

              {/* Centered Iframe Container */}
              <div class="flex-1 bg-gray-50 relative overflow-hidden flex items-center justify-center">
                  <iframe 
                      id="modal-iframe"
                      src="" 
                      data-src="https://www.agentinsure.com/compare/auto-insurance-home-insurance/fortitudeis/quote.aspx" 
                      class="w-full h-full border-0"
                      title="Fortitude Insurance Quoter"
                  ></iframe>
                  {/* Loader */}
                  <div class="absolute inset-0 flex items-center justify-center bg-white pointer-events-none transition-opacity duration-500" id="iframe-loader">
                      <div class="flex flex-col items-center gap-6">
                           <div class="relative w-16 h-16">
                              <div class="absolute inset-0 border-4 border-gray-100 rounded-full"></div>
                              <div class="absolute inset-0 border-4 border-primary border-t-transparent rounded-full animate-spin"></div>
                          </div>
                          <div class="text-center">
                              <p class="text-gray-900 font-bold text-lg">Starting Quoter</p>
                              <p class="text-gray-400 text-sm">Connecting with carriers...</p>
                          </div>
                      </div>
                  </div>
              </div>
          </div>
      </div>
  </div>

  {/* === SECCIÓN DE CONFIANZA (Clean Style) === */}
  {/* Fondo gris muy claro en Light Mode, Oscuro en Dark Mode */}
  <section class="py-24 bg-gray-50 dark:bg-[#111] text-text-main dark:text-white border-y border-transparent dark:border-white/5">
    <div class="container mx-auto px-4">
      
      <div class="max-w-6xl mx-auto text-center mb-16">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-serif font-bold leading-tight tracking-tight">
          Fortitude Insurance provides <br/>
          <span class="text-primary">the support you need</span> when it matters most.
        </h2>
      </div>

      <div class="max-w-3xl mx-auto text-center">
        <p class="text-xl md:text-2xl text-gray-600 dark:text-gray-300 mb-8 leading-relaxed font-light">
          For years, we have made it our business to provide 5-star coverage, with excellent low rates and flexible payment options to keep you covered.
        </p>

        <p class="text-lg text-gray-500 dark:text-gray-400 mb-12">
          Everyone is welcome here, even with less than perfect credit or driving history.
        </p>

        <a href="/about" class="inline-flex items-center gap-2 text-primary font-bold text-lg hover:text-primary-hover transition-colors group mb-20">
          More about Fortitude Insurance
          <svg class="w-5 h-5 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
        </a>
      </div>

      <div class="grid md:grid-cols-3 gap-12 max-w-6xl mx-auto">
        
        <div class="flex flex-col items-center text-center group">
          <div class="w-20 h-20 mb-6 text-text-main dark:text-white group-hover:text-primary transition-colors duration-500 flex items-center justify-center">
             <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full">
                <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2" />
                <circle cx="7" cy="17" r="2" />
                <path d="M9 17h6" />
                <circle cx="17" cy="17" r="2" />
             </svg>
          </div>
          <h3 class="text-2xl font-medium max-w-xs leading-snug">
            Hundreds of insured drivers
          </h3>
        </div>

        <div class="flex flex-col items-center text-center group">
            <div class="w-20 h-20 mb-6 text-text-main dark:text-white group-hover:text-primary transition-colors duration-500 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-full h-full">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
              </svg>
          </div>
          <h3 class="text-2xl font-medium max-w-xs leading-snug">
            Get an auto quote in 2 minutes or less
          </h3>
        </div>

        <div class="flex flex-col items-center text-center group">
          <div class="w-20 h-20 mb-6 text-text-main dark:text-white group-hover:text-primary transition-colors duration-500 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-full h-full">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9z" />
              </svg>
          </div>
          <h3 class="text-2xl font-medium max-w-xs leading-snug">
            Fast and simple claims process
          </h3>
        </div>

      </div>
    </div>
  </section>

{/* === COVERAGES SECTION (3x3 GRID) === */}
  <section class="py-24 bg-white dark:bg-[#0a0a0a] overflow-hidden">
    <div class="container mx-auto px-4">
  
      {/* Centered Header */}
      <div class="max-w-3xl mx-auto text-center mb-16">
        <h2 class="text-4xl md:text-6xl font-serif font-bold text-text-main dark:text-white leading-none mb-6">
          Our <span class="text-primary">Coverages</span>
        </h2>
        <p class="text-lg text-gray-500 dark:text-gray-400 font-light">
           A complete catalog of solutions designed to protect every aspect of your assets.
        </p>
      </div>
  
      {/* 3x3 GRID LOGIC */}
      <div class="flex flex-col gap-6 max-w-7xl mx-auto">
        
        {[
          // ROW 1: Main (Auto, Property, Commercial)
          [
            { 
              title: 'Auto', 
              desc: 'Full coverage for your mobility.', 
              img: autoImg, 
              link: '/auto' 
            },
            { 
              title: 'Property', 
              desc: 'Protection for homeowners and renters.', 
              img: propertyImg, 
              link: '/property' 
            },
            { 
              title: 'Commercial', 
              desc: 'Security for your business and fleet.', 
              img: commercialImg, 
              link: '/commercial' 
            }
          ],
          // ROW 2: Personal & Health (Ahora con imágenes locales)
          [
            { 
              title: 'Health', 
              desc: 'Health plans tailored to your needs.', 
              img: healthImg, 
              link: '/additional-insurance' 
            },
            { 
              title: 'General Liability', 
              desc: 'Protection against third-party claims.', 
              img: liabilityImg, 
              link: '/additional-insurance' 
            },
            { 
              title: 'Renters', 
              desc: 'Protect your belongings inside your home.', 
              img: rentersImg, 
              link: '/additional-insurance' 
            }
          ],
          // ROW 3: Recreational (Ahora con imágenes locales)
          [
            { 
              title: 'Motorcycle', 
              desc: 'Safe adventures on two wheels.', 
              img: motorcycleImg, 
              link: '/additional-insurance' 
            },
            { 
              title: 'Boat', 
              desc: 'Navigate with total peace of mind.', 
              img: boatImg, 
              link: '/additional-insurance' 
            },
            { 
              title: 'RV', 
              desc: 'Your home on any road.', 
              img: rvImg, 
              link: '/additional-insurance' 
            }
          ]
        ].map((row) => (
          
          /* ROW CONTAINER */
          <div class="flex flex-col lg:flex-row gap-4 h-auto lg:h-[400px] w-full">
            
            {row.map((item) => (
              <a 
                href={item.link} 
                class="group relative flex-1 lg:hover:flex-[2.5] transition-[flex] duration-700 ease-[cubic-bezier(0.25,1,0.5,1)] rounded-3xl overflow-hidden cursor-pointer min-h-[280px] lg:min-h-full"
              >
                {/* IMAGE RENDERING: Handles imports automatically */}
                {typeof item.img === 'string' ? (
                  <img 
                    src={item.img} 
                    alt={item.title} 
                    class="absolute inset-0 w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110" 
                  />
                ) : (
                  <Image 
                    src={item.img} 
                    alt={item.title} 
                    class="absolute inset-0 w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110" 
                  />
                )}
                
                {/* Dark Overlay */}
                <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent opacity-80 group-hover:opacity-60 transition-opacity duration-700"></div>
    
                {/* Content */}
                <div class="absolute inset-0 p-8 flex flex-col justify-end z-10">
                  
                  <div class="transform transition-transform duration-500 group-hover:-translate-y-2">
                    <h3 class="text-3xl font-bold text-white mb-2">{item.title}</h3>
                    
                    {/* Expandable Text */}
                    <div class="h-0 lg:h-auto overflow-hidden opacity-0 lg:group-hover:opacity-100 lg:group-hover:h-auto transition-all duration-700 delay-100 lg:max-h-0 lg:group-hover:max-h-40">
                      <p class="text-gray-200 text-sm md:text-base leading-relaxed mb-4 border-l-2 border-primary pl-4">
                        {item.desc}
                      </p>
                      <span class="inline-flex items-center gap-2 text-primary font-bold text-sm uppercase tracking-wider">
                        View Details <span class="group-hover:translate-x-2 transition-transform">&rarr;</span>
                      </span>
                    </div>
                    
                    {/* Text visible on mobile only */}
                    <p class="lg:hidden text-gray-300 text-sm mt-2">{item.desc}</p>
                  </div>
  
                </div>
              </a>
            ))}
  
          </div>
        ))}
        
      </div>
    </div>
  </section>

  {/* CONTACT SECTION */}
  {/* Fondo Claro en Light (con elementos sutiles) y Oscuro en Dark */}
  <section class="py-20 relative overflow-hidden bg-white dark:bg-[#050505]" id="contact-section">
    
    {/* Decoración Sutil de Fondo */}
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-primary/5 dark:bg-primary/10 blur-[100px] rounded-full pointer-events-none"></div>

    <div class="container mx-auto px-4 flex flex-col lg:flex-row items-center gap-12 lg:gap-20 relative z-10">
        
        {/* LEFT COLUMN: Persuasive Text + Contact Info */}
        <div class="lg:w-1/2 relative z-10 text-center lg:text-left">
         
             <span class="inline-block py-1 px-3 rounded-full bg-primary/10 text-primary text-xs font-bold uppercase tracking-widest mb-4">
                Personalized Support
             </span>
             <h2 class="text-4xl md:text-5xl font-serif font-bold mb-6 text-text-main dark:text-white leading-tight">
                Prefer the advice of a <br/>
                <span class="text-primary decoration-4 underline decoration-primary/30">licensed agent?</span>
             </h2>
             <p class="text-lg text-gray-600 dark:text-gray-300 mb-8 leading-relaxed">
                We understand that every situation is unique. If you have doubts about your coverage or need a personalized policy for your company, our team of experts is ready to assist you step by step.
             </p>
             
             <div class="space-y-6">
                 
                 {/* Address */}
                 <div class="flex items-center justify-start lg:justify-start gap-4">
                     <div class="w-12 h-12 bg-gray-100 dark:bg-white/10 rounded-full flex items-center justify-center text-primary flex-shrink-0">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                     </div>
                     <div class="text-left">
                         <p class="text-xs text-gray-500 uppercase tracking-wide font-bold">Visit Us</p>
                         <p class="text-xl font-bold text-text-main dark:text-white text-base">
                             28210 Paseo Drive #190<br/>
                             Wesley Chapel, FL 33543
                         </p>
                     </div>
                 </div>

                 {/* Phone */}
                 <div class="flex items-center justify-start lg:justify-start gap-4">
                     <div class="w-12 h-12 bg-gray-100 dark:bg-white/10 rounded-full flex items-center justify-center text-primary flex-shrink-0">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                     </div>
                     <div class="text-left">
                         <p class="text-xs text-gray-500 uppercase tracking-wide font-bold">Call Us Directly</p>
                         <p class="text-xl font-bold text-text-main dark:text-white">(813) 753-4197</p>
                     </div>
                 </div>

                 {/* Email */}
                 <div class="flex items-center justify-start lg:justify-start gap-4">
                     <div class="w-12 h-12 bg-gray-100 dark:bg-white/10 rounded-full flex items-center justify-center text-primary flex-shrink-0">
                         <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                     </div>
                     <div class="text-left">
                         <p class="text-xs text-gray-500 uppercase tracking-wide font-bold">Email</p>
                         <a href="mailto:support@fortitudeins.us" class="text-xl font-bold text-text-main dark:text-white hover:text-primary transition-colors">
                             support@fortitudeins.us
                         </a>
                     </div>
                 </div>

             </div>
        </div>

        {/* RIGHT COLUMN: Form */}
        <div class="lg:w-1/2 w-full relative z-10">
             <div class="bg-surface-light dark:bg-[#151515] p-8 md:p-10 rounded-3xl shadow-xl border border-gray-100 dark:border-white/10">
                <form id="contact-form" class="space-y-6">
                    <div class="grid md:grid-cols-2 gap-6">
                        <div class="space-y-2">
                            <label for="name" class="text-sm font-medium text-gray-700 dark:text-gray-300">Full Name</label>
                            <input type="text" id="name" name="name" required 
                                class="w-full px-4 py-3 rounded-lg bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-gray-700 focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all dark:text-white" placeholder="Ex. John Doe" />
                        </div>
                        <div class="space-y-2">
                            <label for="phone" class="text-sm font-medium text-gray-700 dark:text-gray-300">Phone</label>
                            <input type="tel" id="phone" name="phone" required 
                                class="w-full px-4 py-3 rounded-lg bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-gray-700 focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all dark:text-white" placeholder="(000) 000-0000" />
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label for="email" class="text-sm font-medium text-gray-700 dark:text-gray-300">Email</label>
                        <input type="email" id="email" name="email" required 
                            class="w-full px-4 py-3 rounded-lg bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-gray-700 focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all dark:text-white" placeholder="john@example.com" />
                    </div>

                    <div class="space-y-2">
                        <label for="interest" class="text-sm font-medium text-gray-700 dark:text-gray-300">Type of insurance</label>
                        <div class="relative">
                            <select id="interest" name="interest" class="w-full px-4 py-3 rounded-lg bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-gray-700 focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all appearance-none dark:text-white cursor-pointer">
                                <option value="Auto">Auto Insurance</option>
                                <option value="Hogar">Home Insurance</option>
                                <option value="Comercial">Commercial Insurance</option>
                                <option value="Otro">Other / General Inquiry</option>
                            </select>
                            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-gray-500">
                                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                            </div>
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label for="message" class="text-sm font-medium text-gray-700 dark:text-gray-300">Message</label>
                        <textarea id="message" name="message" rows="3" 
                            class="w-full px-4 py-3 rounded-lg bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-gray-700 focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all resize-none dark:text-white" placeholder="How can we help you?"></textarea>
                    </div>

                    <button type="submit" id="submit-btn" class="w-full bg-primary hover:bg-primary-hover text-text-main font-bold py-4 rounded-lg shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 flex items-center justify-center gap-2">
                        <span>Send Inquiry</span>
                        <svg id="btn-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>

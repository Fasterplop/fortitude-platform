  <script is:inline>
      const form = document.getElementById('contact-form');
      const submitBtn = document.getElementById('submit-btn');
      const btnIcon = document.getElementById('btn-icon');
      const btnLoader = document.getElementById('btn-loader');
      const formMessage = document.getElementById('form-message');

      if (form) {
          form.addEventListener('submit', async (e) => {
              e.preventDefault();
              
              // UI Loading State
              submitBtn.disabled = true;
              submitBtn.classList.add('opacity-75', 'cursor-not-allowed');
              btnIcon.classList.add('hidden');
              btnLoader.classList.remove('hidden');
              formMessage.classList.add('hidden');

              const formData = new FormData(form);
              const data = Object.fromEntries(formData);

              try {
                  const response = await fetch('/api/send-email', {
                      method: 'POST',
                      headers: {
                          'Content-Type': 'application/json',
                      },
                      body: JSON.stringify(data),
                  });

                  if (response.ok) {
                      form.reset();
                      formMessage.textContent = "¡Gracias! Su mensaje ha sido enviado. Nos pondremos en contacto pronto.";
                      formMessage.className = "text-center text-sm font-medium text-green-600 mt-4 block p-3 bg-green-50 rounded-lg";
                  } else {
                      throw new Error('Error en el envío');
                  }
              } catch (error) {
                  formMessage.textContent = "Hubo un error al enviar el mensaje. Por favor intente nuevamente o llámenos.";
                  formMessage.className = "text-center text-sm font-medium text-red-600 mt-4 block p-3 bg-red-50 rounded-lg";
              } finally {
                  // Reset UI
                  submitBtn.disabled = false;
                  submitBtn.classList.remove('opacity-75', 'cursor-not-allowed');
                  btnIcon.classList.remove('hidden');
                  btnLoader.classList.add('hidden');
                  formMessage.classList.remove('hidden');
              }
          });
      }
  </script>



  <script is:inline>
    // ELEMENTOS DEL DOM
    const openBtn = document.getElementById('open-quote-modal');
    const modal = document.getElementById('quote-modal');
    const closeBtn = document.getElementById('close-modal-btn');
    const backdrop = document.getElementById('modal-backdrop');
    const iframe = document.getElementById('modal-iframe');
    const loader = document.getElementById('iframe-loader');

    // FUNCIONES DEL MODAL
    function openModal() {
        if (!modal) return;
        
        // 1. Mostrar contenedor
        modal.classList.remove('hidden');
        
        // 2. Cargar Iframe (Lazy Loading para que no pese al inicio)
        if (iframe && !iframe.getAttribute('src')) {
            iframe.setAttribute('src', iframe.getAttribute('data-src'));
            // Ocultar loader cuando cargue
            iframe.onload = () => {
                if(loader) loader.style.opacity = '0';
            };
        }

        // 3. Animación de entrada
        setTimeout(() => {
            modal.classList.remove('opacity-0');
            document.body.style.overflow = 'hidden'; // Evitar scroll trasero
        }, 10);
    }

    function closeModal() {
        if (!modal) return;

        // 1. Animación de salida
        modal.classList.add('opacity-0');
        document.body.style.overflow = ''; // Restaurar scroll

        // 2. Ocultar tras la animación
        setTimeout(() => {
            modal.classList.add('hidden');
        }, 300);
    }

    // EVENT LISTENERS
    if (openBtn) openBtn.addEventListener('click', openModal);
    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (backdrop) backdrop.addEventListener('click', closeModal);

    // Cerrar con tecla ESC
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
            closeModal();
        }
    });
  </script>

  <style>

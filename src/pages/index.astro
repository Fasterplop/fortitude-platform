---
import Layout from '../layouts/Layout.astro';
import EZLynxFrame from '../components/EZLynxFrame.astro';
import CarriersCarousel from '../components/CarriersCarousel.astro';

const title = "Fortitude Insurance Services LLC | Seguros de Auto, Hogar y Comercial";
const description = "Cotice en tiempo real. Seguros confiables en Florida y Texas.";

const quoteUrl = "https://www.agentinsure.com/compare/auto-insurance-home-insurance/fortitudeis/quote.aspx";
const accountUrl = "https://customerservice.agentinsure.com/EzlynxCustomerService/fortitudeis/Account/LogIn";
---

<Layout title={title} description={description}>
  
  <section class="relative bg-surface-light dark:bg-surface-dark pt-12 pb-20 overflow-visible">
    <div class="container mx-auto px-4 relative z-10">
      <div class="flex flex-col lg:flex-row items-center gap-12">
        
        <div class="lg:w-5/12 space-y-6 text-center lg:text-left">
          <h1 class="text-5xl lg:text-6xl font-serif font-bold text-text-main dark:text-surface-light leading-tight">
            Protección que avanza <span class="text-primary italic">contigo</span>.
          </h1>
          <p class="text-lg text-gray-600 dark:text-gray-300">
            Seguros diseñados para la era moderna en FL y TX. Sin complicaciones.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
            <button id="start-quote-btn" class="bg-primary hover:bg-primary-hover text-text-main font-bold py-4 px-10 rounded-md shadow-lg transform transition hover:-translate-y-1 cursor-pointer">
              Empezar a Cotizar
            </button>
            <a href="/contact" class="flex items-center justify-center gap-2 border border-gray-300 dark:border-gray-700 text-text-main dark:text-surface-light font-medium py-4 px-8 rounded-md hover:bg-gray-50 dark:hover:bg-white/5 transition-colors">
              Contactar Agente
            </a>
          </div>
        </div>

        <div id="quote-container" class="lg:w-7/12 w-full relative transition-all duration-700 rounded-xl">
            <div class="absolute -inset-1 bg-gradient-to-r from-primary to-primary-hover rounded-xl blur opacity-20 dark:opacity-40 animate-pulse"></div>
            <EZLynxFrame src={quoteUrl} title="Cotizador Seguro" id="main-quote-frame" heightPx={850} />
        </div>

      </div>
    </div>
  </section>

  <CarriersCarousel />

  <section class="py-24 bg-white dark:bg-surface-card border-b border-gray-100 dark:border-gray-800">
  <div class="container mx-auto px-4">
    
    <div class="max-w-6xl mx-auto text-center mb-10">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-serif font-bold text-text-main dark:text-white leading-tight tracking-tight">
        Fortitude Insurance le brinda el respaldo que necesita cuando más importa.
      </h2>
    </div>

    <div class="max-w-3xl mx-auto text-center">
      <p class="text-xl md:text-2xl text-gray-600 dark:text-gray-300 mb-8 leading-relaxed font-light">
        Durante años, hemos hecho nuestro negocio brindar cobertura de 5 estrellas, con excelentes tarifas bajas y opciones de pago flexibles para mantenerlo cubierto.
      </p>

      <p class="text-lg text-gray-500 dark:text-gray-400 mb-12">
        Todos son bienvenidos aquí, incluso con historial de crédito o manejo menos que perfecto.
      </p>

      <a href="/about" class="inline-flex items-center gap-2 text-primary font-bold text-lg hover:text-primary-hover transition-colors group mb-20">
        Más sobre Fortitude Insurance
        <svg class="w-5 h-5 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
      </a>
    </div>

    <div class="grid md:grid-cols-3 gap-12 max-w-6xl mx-auto">
      
      <div class="flex flex-col items-center text-center group">
        <div class="w-20 h-20 mb-6 text-text-main dark:text-white group-hover:text-primary transition-colors duration-500 flex items-center justify-center">
           <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full">
              <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2" />
              <circle cx="7" cy="17" r="2" />
              <path d="M9 17h6" />
              <circle cx="17" cy="17" r="2" />
           </svg>
        </div>
        <h3 class="text-2xl font-medium text-text-main dark:text-white max-w-xs leading-snug">
          Cientos de conductores asegurados
        </h3>
      </div>

      <div class="flex flex-col items-center text-center group">
        <div class="w-20 h-20 mb-6 text-text-main dark:text-white group-hover:text-primary transition-colors duration-500 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-full h-full">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
            </svg>
        </div>
        <h3 class="text-2xl font-medium text-text-main dark:text-white max-w-xs leading-snug">
          Obtenga una cotización de auto en 2 minutos o menos
        </h3>
      </div>

      <div class="flex flex-col items-center text-center group">
        <div class="w-20 h-20 mb-6 text-text-main dark:text-white group-hover:text-primary transition-colors duration-500 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-full h-full">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9z" />
            </svg>
        </div>
        <h3 class="text-2xl font-medium text-text-main dark:text-white max-w-xs leading-snug">
          Proceso de reclamos rápido y sencillo
        </h3>
      </div>

    </div>
  </div>
</section>

  <section class="py-24 bg-gray-50 dark:bg-[#111]">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-serif font-bold mb-4 dark:text-white">Coberturas a tu medida</h2>
        <p class="text-gray-500 max-w-2xl mx-auto">Selecciona el tipo de protección que necesitas hoy.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        
        <a href="/auto" class="group relative h-[450px] rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-500">
            <div class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-110" style="background-image: url('https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?auto=format&fit=crop&q=80');"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent"></div>
            <div class="absolute bottom-0 left-0 p-8 w-full">
                <div class="mb-4 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                    <h3 class="text-3xl font-bold text-white mb-2">Auto</h3>
                    <p class="text-gray-300 text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-500 delay-100">Protección completa para tu vehículo.</p>
                </div>
                <div class="w-full h-1 bg-gray-700 rounded overflow-hidden mt-4">
                    <div class="w-0 h-full bg-primary group-hover:w-full transition-all duration-700 ease-out"></div>
                </div>
            </div>
        </a>

        <a href="/property" class="group relative h-[450px] rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-500">
            <div class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-110" style="background-image: url('https://images.unsplash.com/photo-1568605114967-8130f3a36994?auto=format&fit=crop&q=80');"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent"></div>
            <div class="absolute bottom-0 left-0 p-8 w-full">
                <div class="mb-4 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                     <h3 class="text-3xl font-bold text-white mb-2">Propiedad</h3>
                    <p class="text-gray-300 text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-500 delay-100">Seguridad para tu hogar y bienes.</p>
                </div>
                <div class="w-full h-1 bg-gray-700 rounded overflow-hidden mt-4">
                    <div class="w-0 h-full bg-primary group-hover:w-full transition-all duration-700 ease-out"></div>
                </div>
            </div>
        </a>

        <a href="/commercial" class="group relative h-[450px] rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-500">
            <div class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-110" style="background-image: url('https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&q=80');"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent"></div>
            <div class="absolute bottom-0 left-0 p-8 w-full">
                <div class="mb-4 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                    <h3 class="text-3xl font-bold text-white mb-2">Comercial</h3>
                    <p class="text-gray-300 text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-500 delay-100">Respaldo sólido para tu negocio.</p>
                </div>
                <div class="w-full h-1 bg-gray-700 rounded overflow-hidden mt-4">
                    <div class="w-0 h-full bg-primary group-hover:w-full transition-all duration-700 ease-out"></div>
                </div>
            </div>
        </a>
      </div>
    </div>
  </section>

  <section class="py-20 bg-surface-light dark:bg-surface-dark overflow-hidden relative">
    <div class="container mx-auto px-4 flex flex-col md:flex-row items-center">
        <div class="md:w-1/2 relative z-10 mb-10 md:mb-0">
             <img src="/images/fortitude-logo.png" 
                  alt="Asistencia en el camino" 
                  class="w-full max-w-lg mx-auto drop-shadow-2xl hover:scale-105 transition-transform duration-500"
                  onerror="this.src='https://placehold.co/600x400/transparent/C5A059?text=Ilustracion'" />
        </div>
        <div class="md:w-1/2 md:pl-16 relative z-10">
            <h2 class="text-4xl font-serif font-bold mb-6 dark:text-white">
                Estamos ahí cuando <br/> <span class="text-primary decoration-4 underline decoration-primary/30">más importa</span>.
            </h2>
            <p class="text-lg text-gray-600 dark:text-gray-300 mb-8 leading-relaxed">
                No somos solo un contrato en papel. Somos la respuesta rápida ante un incidente.
            </p>
            <ul class="space-y-4 mb-8">
                <li class="flex items-center gap-3">
                    <span class="bg-green-100 text-green-600 p-1 rounded-full"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M5 13l4 4L19 7"></path></svg></span>
                    <span class="dark:text-gray-300 font-medium">Respuesta inmediata 24/7</span>
                </li>
            </ul>
        </div>
        <div class="absolute top-0 right-0 w-1/2 h-full bg-gray-50 dark:bg-[#151515] -skew-x-12 transform origin-top-right -z-0"></div>
    </div>
  </section>

  <section class="py-24 bg-[#1a1a1a] text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')] opacity-20"></div>
    <div class="container mx-auto px-4 relative z-10">
        <div class="flex flex-col lg:flex-row gap-16 items-center">
            <div class="lg:w-1/3">
                <div class="bg-white/5 backdrop-blur-md border border-white/10 p-8 rounded-2xl shadow-2xl">
                    <div class="w-16 h-16 bg-primary rounded-2xl flex items-center justify-center mb-6 shadow-lg shadow-primary/40">
                         <svg class="w-8 h-8 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    </div>
                    <h2 class="text-3xl font-serif font-bold mb-4">Client Center</h2>
                    <p class="text-gray-400 mb-8">Accede a tu portal seguro para gestionar pólizas, pagos y documentos.</p>
                    <div class="grid grid-cols-2 gap-4">
                        <div class="bg-white/5 p-4 rounded-lg text-center hover:bg-white/10 transition-colors cursor-default">
                            <span class="text-xs font-bold uppercase block text-primary mb-1">ID Cards</span>
                            <span class="text-xs text-gray-400">Descargar</span>
                        </div>
                        <div class="bg-white/5 p-4 rounded-lg text-center hover:bg-white/10 transition-colors cursor-default">
                             <span class="text-xs font-bold uppercase block text-primary mb-1">Docs</span>
                             <span class="text-xs text-gray-400">Revisar</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="lg:w-2/3 w-full">
                <div class="bg-[#111] rounded-xl overflow-hidden shadow-2xl border border-gray-800">
                    <div class="bg-[#000] px-4 py-3 border-b border-gray-800 flex items-center justify-between">
                        <div class="flex gap-2">
                            <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
                            <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
                            <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
                        </div>
                        <div class="text-xs text-gray-500 font-mono">Secure Connection</div>
                    </div>
                    <div class="bg-white"> 
  <EZLynxFrame src={accountUrl} title="Portal de Clientes" heightPx={1000} /> 
</div>
                </div>
            </div>
        </div>
    </div>
  </section>

  <script is:inline>
    const startBtn = document.getElementById('start-quote-btn');
    const quoteContainer = document.getElementById('quote-container');

    if (startBtn && quoteContainer) {
        startBtn.addEventListener('click', (e) => {
            e.preventDefault();
            
            
            // 2. Efecto de "Glow" (Anillo dorado + escala sutil)
            // Añadimos clases de Tailwind para un anillo dorado brillante
            quoteContainer.classList.add('ring-4', 'ring-primary', 'ring-offset-4', 'ring-offset-surface-light', 'dark:ring-offset-surface-dark', 'scale-[1.01]', 'shadow-[0_0_50px_rgba(197,160,89,0.5)]');

            // 3. Quitar el efecto después de 2 segundos para que no moleste
            setTimeout(() => {
                 quoteContainer.classList.remove('ring-4', 'ring-primary', 'ring-offset-4', 'ring-offset-surface-light', 'dark:ring-offset-surface-dark', 'scale-[1.01]', 'shadow-[0_0_50px_rgba(197,160,89,0.5)]');
            }, 500);
        });
    }
  </script>

</Layout>
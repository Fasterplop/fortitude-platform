---
import Layout from '../layouts/Layout.astro';
import CarriersCarousel from '../components/CarriersCarousel.astro';
import { Image } from 'astro:assets';
import autoImg from '../images/auto.jpg';
import propertyImg from '../images/property.jpg';
import commercialImg from '../images/commercial.jpg';

const title = "Fortitude Insurance Services LLC | Seguros de Auto, Hogar y Comercial";
const description = "Cotice en tiempo real. Seguros confiables en Florida y Texas.";
---

<Layout title={title} description={description}>
  
  {/* === HERO SECTION === */}
  <section class="relative min-h-[90vh] flex flex-col justify-center overflow-hidden bg-surface-light dark:bg-surface-dark pt-20 pb-10">
    

    <div class="container mx-auto px-4 relative z-10 text-center flex-1 flex flex-col justify-center">
      
      {/* Título Principal */}
      <h1 class="text-5xl md:text-7xl lg:text-8xl font-serif font-bold text-text-main dark:text-surface-light tracking-tight leading-[1.1] mb-6">
        Cotiza y asegura  <br/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary via-yellow-500 to-yellow-600">en solo minutos</span>.
      </h1>

      {/* Subtítulo */}
      <p class="text-xl md:text-2xl text-gray-600 dark:text-gray-300 max-w-4xl mx-auto mb-10 font-light leading-relaxed">
        Con Fortitude Insurance obtén protección integral para tu auto, hogar o negocio en Florida y Texas con tecnología en tiempo real y respaldo experto.
      </p>

      {/* Botones de Acción */}
      <div class="flex flex-col sm:flex-row items-center justify-center gap-6 mb-8">
        <button id="open-quote-modal" class="group relative px-10 py-5 bg-text-main dark:bg-white text-white dark:text-black font-bold text-lg rounded-full hover:-translate-y-1 transition-all duration-300 overflow-hidden min-w-[220px]">
            <span class="relative z-10 flex items-center justify-center gap-3">
               Iniciar Cotización
               <svg class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </span>
            <div class="absolute inset-0 -translate-x-full group-hover:translate-x-full transition-transform duration-700 bg-gradient-to-r from-transparent via-white/20 to-transparent"></div>
        </button>
        
        <a href="/contact" class="text-gray-600 dark:text-gray-300 font-medium hover:text-primary transition-colors flex items-center gap-2 px-6 py-4 rounded-full hover:bg-gray-100 dark:hover:bg-white/10">
           Hablar con un Agente
        </a>
      </div>

      {/* Microcopia UX (Trust & Speed) */}
      <p class="text-xs md:text-sm text-gray-500 dark:text-gray-400 font-medium mb-12 flex items-center justify-center gap-2 opacity-90">
         <span>⏱️ Cotiza en solo 3 a 5 minutos.</span>
         <span class="hidden sm:inline">•</span>
         <span>Este proceso es gratuito y no afecta tu puntaje de crédito.</span>
      </p>

      {/* CARRUSEL DE CARRIERS INTEGRADO EN EL HERO */}
      <div class="w-full mx-auto border-t border-gray-200/50 dark:border-white/5 pt-8">
          <CarriersCarousel />
      </div>

    </div>
</section>

  {/* === MODAL DEL COTIZADOR === */}
  <div id="quote-modal" class="fixed inset-0 z-[100] hidden opacity-0 transition-opacity duration-300" aria-hidden="true">
      {/* Backdrop */}
      <div class="absolute inset-0 bg-black/80 backdrop-blur-md" id="modal-backdrop"></div>
      
      <div class="relative z-10 w-full h-full flex items-center justify-center p-4 md:p-8">
          <div class="bg-white w-full max-w-7xl h-[90vh] rounded-2xl overflow-hidden shadow-2xl flex flex-col relative animate-scale-in ring-1 ring-white/20">
              
              {/* Header del Modal - LOGO FORTITUDE */}
              <div class="bg-surface-light dark:bg-surface-light px-6 py-4 border-b border-gray-200 flex items-center justify-between shadow-sm z-20">
                  <div class="flex items-center gap-4">
                      {/* Logo Reemplazado */}
                      <img src="/images/fortitude-logo.png" alt="Fortitude Insurance" class="h-10 w-auto object-contain" />
                      
                      <div class="hidden sm:block">
                          <h3 class="font-bold text-gray-900 text-lg leading-tight">Fortitude Insurance</h3>
                          <p class="text-xs text-gray-500 font-medium tracking-wide uppercase flex items-center gap-1.5">
                              <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
                              Plataforma de Cotización Oficial
                          </p>
                      </div>
                  </div>
                  <button id="close-modal-btn" class="group p-2 hover:bg-gray-100 rounded-full transition-colors text-gray-400 hover:text-red-500">
                      <svg class="w-6 h-6 transform group-hover:rotate-90 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                  </button>
              </div>

              {/* Contenedor del Iframe Centrado */}
              <div class="flex-1 bg-gray-50 relative overflow-hidden flex items-center justify-center">
                  <iframe 
                      id="modal-iframe"
                      src="" 
                      data-src="https://www.agentinsure.com/compare/auto-insurance-home-insurance/fortitudeis/quote.aspx" 
                      class="w-full h-full border-0"
                      title="Cotizador Fortitude Insurance"
                  ></iframe>
                  
                  {/* Loader */}
                  <div class="absolute inset-0 flex items-center justify-center bg-white pointer-events-none transition-opacity duration-500" id="iframe-loader">
                      <div class="flex flex-col items-center gap-6">
                          <div class="relative w-16 h-16">
                              <div class="absolute inset-0 border-4 border-gray-100 rounded-full"></div>
                              <div class="absolute inset-0 border-4 border-primary border-t-transparent rounded-full animate-spin"></div>
                          </div>
                          <div class="text-center">
                              <p class="text-gray-900 font-bold text-lg">Iniciando Cotizador</p>
                              <p class="text-gray-400 text-sm">Conectando con aseguradoras...</p>
                          </div>
                      </div>
                  </div>
              </div>

          </div>
      </div>
  </div>

  <section class="py-24 bg-white dark:bg-surface-card border-b border-gray-100 dark:border-gray-800">
  <div class="container mx-auto px-4">
    
    <div class="max-w-6xl mx-auto text-center mb-10">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-serif font-bold text-text-main dark:text-white leading-tight tracking-tight">
        Fortitude Insurance le brinda el respaldo que necesita cuando más importa.
      </h2>
    </div>

    <div class="max-w-3xl mx-auto text-center">
      <p class="text-xl md:text-2xl text-gray-600 dark:text-gray-300 mb-8 leading-relaxed font-light">
        Durante años, hemos hecho nuestro negocio brindar cobertura de 5 estrellas, con excelentes tarifas bajas y opciones de pago flexibles para mantenerlo cubierto.
      </p>

      <p class="text-lg text-gray-500 dark:text-gray-400 mb-12">
        Todos son bienvenidos aquí, incluso con historial de crédito o manejo menos que perfecto.
      </p>

      <a href="/about" class="inline-flex items-center gap-2 text-primary font-bold text-lg hover:text-primary-hover transition-colors group mb-20">
        Más sobre Fortitude Insurance
        <svg class="w-5 h-5 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
      </a>
    </div>

    <div class="grid md:grid-cols-3 gap-12 max-w-6xl mx-auto">
      
      <div class="flex flex-col items-center text-center group">
        <div class="w-20 h-20 mb-6 text-text-main dark:text-white group-hover:text-primary transition-colors duration-500 flex items-center justify-center">
           <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full">
              <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2" />
              <circle cx="7" cy="17" r="2" />
              <path d="M9 17h6" />
              <circle cx="17" cy="17" r="2" />
           </svg>
        </div>
        <h3 class="text-2xl font-medium text-text-main dark:text-white max-w-xs leading-snug">
          Cientos de conductores asegurados
        </h3>
      </div>

      <div class="flex flex-col items-center text-center group">
        <div class="w-20 h-20 mb-6 text-text-main dark:text-white group-hover:text-primary transition-colors duration-500 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-full h-full">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
            </svg>
        </div>
        <h3 class="text-2xl font-medium text-text-main dark:text-white max-w-xs leading-snug">
          Obtenga una cotización de auto en 2 minutos o menos
        </h3>
      </div>

      <div class="flex flex-col items-center text-center group">
        <div class="w-20 h-20 mb-6 text-text-main dark:text-white group-hover:text-primary transition-colors duration-500 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-full h-full">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9z" />
            </svg>
        </div>
        <h3 class="text-2xl font-medium text-text-main dark:text-white max-w-xs leading-snug">
          Proceso de reclamos rápido y sencillo
        </h3>
      </div>

    </div>
  </div>
</section>

<section class="py-24 bg-white dark:bg-[#111] overflow-hidden">
  <div class="container mx-auto px-4">
    
    {/* Encabezado */}
    <div class="flex flex-col md:flex-row items-end justify-between mb-12 gap-6">
      <div class="max-w-2xl">
        <h2 class="text-4xl md:text-6xl font-serif font-bold text-text-main dark:text-white leading-none mb-4">
          Nuestras <span class="text-primary">Coberturas</span>
        </h2>
        <p class="text-lg text-gray-500 dark:text-gray-400 font-light">
          Soluciones de riesgo diseñadas con precisión para cada etapa de tu vida y negocio.
        </p>
      </div>
      
      {/* Indicador visual */}
      <div class="hidden md:flex items-center gap-2 pb-2 opacity-50">
        <span class="text-xs font-mono uppercase tracking-widest text-gray-400">Selecciona una categoría</span>
        <svg class="w-12 h-px text-gray-300" viewBox="0 0 50 1"><rect width="50" height="1" fill="currentColor"/></svg>
      </div>
    </div>

    {/* LAYOUT ACORDEÓN HORIZONTAL */}
    <div class="flex flex-col lg:flex-row gap-4 h-auto lg:h-[600px] w-full">
      
      {/* === CARD 1: AUTO === */}
      <a href="/auto" class="group relative flex-1 lg:hover:flex-[2.5] transition-[flex] duration-700 ease-[cubic-bezier(0.25,1,0.5,1)] rounded-3xl overflow-hidden cursor-pointer min-h-[300px] lg:min-h-full">
        
        {/* IMAGEN DE FONDO */}
        <Image src={autoImg} alt="Seguro de Auto" class="absolute inset-0 w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110" />
        
        {/* Overlay Gradiente Oscuro */}
        <div class="absolute inset-0 bg-black/60 group-hover:bg-black/40 transition-colors duration-700"></div>

        {/* Contenido */}
        <div class="absolute inset-0 p-8 flex flex-col justify-between z-10">
          
          {/* Top: Número y Icono ACTUALIZADO */}
          <div class="flex justify-between items-start">
            
            <div class="w-12 h-12 bg-white/10 backdrop-blur-md rounded-full flex items-center justify-center text-white border border-white/10 group-hover:bg-primary group-hover:border-primary transition-colors duration-500 p-2.5">
               {/* NUEVO ICONO DE AUTO SOLICITADO */}
               <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full">
                 <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2" />
                 <circle cx="7" cy="17" r="2" />
                 <path d="M9 17h6" />
                 <circle cx="17" cy="17" r="2" />
               </svg>
            </div>
          </div>

          {/* Bottom: Texto */}
          <div>
            <h3 class="text-3xl font-bold text-white mb-2 transform transition-transform duration-500 group-hover:-translate-y-2">Auto</h3>
            
            <div class="h-0 lg:h-auto overflow-hidden opacity-0 lg:group-hover:opacity-100 lg:group-hover:h-auto transition-all duration-700 delay-100 lg:max-h-0 lg:group-hover:max-h-40">
               <p class="text-gray-200 text-sm md:text-base leading-relaxed mb-4 border-l-2 border-primary pl-4">
                 Desde cobertura básica hasta protección total contra colisiones. Aseguramos tu movilidad con las mejores tarifas del mercado.
               </p>
               <span class="inline-flex items-center gap-2 text-primary font-bold text-sm uppercase tracking-wider">
                 Ver Opciones <span class="group-hover:translate-x-2 transition-transform">&rarr;</span>
               </span>
            </div>
            {/* Texto Móvil */}
            <p class="lg:hidden text-gray-300 text-sm mt-2">Cobertura personal y comercial.</p>
          </div>
        </div>
      </a>

      {/* === CARD 2: PROPIEDAD === */}
      <a href="/property" class="group relative flex-1 lg:hover:flex-[2.5] transition-[flex] duration-700 ease-[cubic-bezier(0.25,1,0.5,1)] rounded-3xl overflow-hidden cursor-pointer min-h-[300px] lg:min-h-full">
        
        {/* IMAGEN DE FONDO */}
       <Image src={propertyImg} alt="Seguro de Auto" class="absolute inset-0 w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110" />

        <div class="absolute inset-0 bg-black/60 group-hover:bg-black/40 transition-colors duration-700"></div>

        <div class="absolute inset-0 p-8 flex flex-col justify-between z-10">
          <div class="flex justify-between items-start">
            
            <div class="w-12 h-12 bg-white/10 backdrop-blur-md rounded-full flex items-center justify-center text-white border border-white/10 group-hover:bg-primary group-hover:border-primary transition-colors duration-500">
               <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
            </div>
          </div>

          <div>
            <h3 class="text-3xl font-bold text-white mb-2 transform transition-transform duration-500 group-hover:-translate-y-2">Propiedad</h3>
            <div class="h-0 lg:h-auto overflow-hidden opacity-0 lg:group-hover:opacity-100 lg:group-hover:h-auto transition-all duration-700 delay-100 lg:max-h-0 lg:group-hover:max-h-40">
               <p class="text-gray-200 text-sm md:text-base leading-relaxed mb-4 border-l-2 border-primary pl-4">
                 Protege tu inversión más importante. Seguros para propietarios, inquilinos y protección contra desastres naturales en FL y TX.
               </p>
               <span class="inline-flex items-center gap-2 text-primary font-bold text-sm uppercase tracking-wider">
                 Ver Opciones <span class="group-hover:translate-x-2 transition-transform">&rarr;</span>
               </span>
            </div>
            <p class="lg:hidden text-gray-300 text-sm mt-2">Hogar, Condo y Renters.</p>
          </div>
        </div>
      </a>

      {/* === CARD 3: COMERCIAL === */}
      <a href="/commercial" class="group relative flex-1 lg:hover:flex-[2.5] transition-[flex] duration-700 ease-[cubic-bezier(0.25,1,0.5,1)] rounded-3xl overflow-hidden cursor-pointer min-h-[300px] lg:min-h-full">
        
        {/* IMAGEN DE FONDO */}
        <Image src={commercialImg} alt="Seguro de Auto" class="absolute inset-0 w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110" />

        <div class="absolute inset-0 bg-black/60 group-hover:bg-black/40 transition-colors duration-700"></div>

        <div class="absolute inset-0 p-8 flex flex-col justify-between z-10">
          <div class="flex justify-between items-start">
            
            <div class="w-12 h-12 bg-white/10 backdrop-blur-md rounded-full flex items-center justify-center text-white border border-white/10 group-hover:bg-primary group-hover:border-primary transition-colors duration-500">
               <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
            </div>
          </div>

          <div>
            <h3 class="text-3xl font-bold text-white mb-2 transform transition-transform duration-500 group-hover:-translate-y-2">Comercial</h3>
            <div class="h-0 lg:h-auto overflow-hidden opacity-0 lg:group-hover:opacity-100 lg:group-hover:h-auto transition-all duration-700 delay-100 lg:max-h-0 lg:group-hover:max-h-40">
               <p class="text-gray-200 text-sm md:text-base leading-relaxed mb-4 border-l-2 border-primary pl-4">
                 Asegura la continuidad de tu negocio. General Liability, Workers Comp y flotas comerciales a tu medida.
               </p>
               <span class="inline-flex items-center gap-2 text-primary font-bold text-sm uppercase tracking-wider">
                 Ver Opciones <span class="group-hover:translate-x-2 transition-transform">&rarr;</span>
               </span>
            </div>
             <p class="lg:hidden text-gray-300 text-sm mt-2">Negocios y Flotas.</p>
          </div>
        </div>
      </a>

    </div>
  </div>
</section>

  {/* SECCION CONTACTO 50/50 CON FORMULARIO */}
  <section class="py-20 bg-surface-light dark:bg-surface-dark overflow-hidden relative" id="contact-section">
    
    <div class="container mx-auto px-4 flex flex-col lg:flex-row items-center gap-12 lg:gap-20">
        
        {/* COLUMNA IZQUIERDA: Texto Persuasivo + Información de Contacto */}
        <div class="lg:w-1/2 relative z-10 text-center lg:text-left">
             <span class="inline-block py-1 px-3 rounded-full bg-primary/10 text-primary text-xs font-bold uppercase tracking-widest mb-4">
                Soporte Personalizado
             </span>
             <h2 class="text-4xl md:text-5xl font-serif font-bold mb-6 text-text-main dark:text-white leading-tight">
                ¿Prefiere la asesoría de un <br/>
                <span class="text-primary decoration-4 underline decoration-primary/30">agente licenciado?</span>
             </h2>
             <p class="text-lg text-gray-600 dark:text-gray-300 mb-8 leading-relaxed">
                Entendemos que cada situación es única. Si tiene dudas sobre su cobertura o necesita una póliza personalizada para su empresa, nuestro equipo de expertos está listo para asistirle paso a paso.
             </p>
             
             <div class="space-y-6">
                 
                 {/* Dirección (NUEVO) */}
                 <div class="flex items-center justify-center lg:justify-start gap-4">
                     <div class="w-12 h-12 bg-gray-100 dark:bg-white/10 rounded-full flex items-center justify-center text-primary flex-shrink-0">
                        {/* Icono de Mapa/Ubicación */}
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                     </div>
                     <div class="text-left">
                         <p class="text-xs text-gray-500 uppercase tracking-wide font-bold">Visítenos</p>
                         <p class="text-xl font-bold text-text-main dark:text-white text-base">
                             28210 Paseo Drive #190<br/>
                             Wesley Chapel, FL 33543
                         </p>
                     </div>
                 </div>

                 {/* Teléfono */}
                 <div class="flex items-center justify-center lg:justify-start gap-4">
                     <div class="w-12 h-12 bg-gray-100 dark:bg-white/10 rounded-full flex items-center justify-center text-primary flex-shrink-0">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                     </div>
                     <div class="text-left">
                         <p class="text-xs text-gray-500 uppercase tracking-wide font-bold">Llámenos Directamente</p>
                         <p class="text-xl font-bold text-text-main dark:text-white">(813) 753-4197</p>
                     </div>
                 </div>

                 {/* Correo Electrónico */}
                 <div class="flex items-center justify-center lg:justify-start gap-4">
                     <div class="w-12 h-12 bg-gray-100 dark:bg-white/10 rounded-full flex items-center justify-center text-primary flex-shrink-0">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                     </div>
                     <div class="text-left">
                         <p class="text-xs text-gray-500 uppercase tracking-wide font-bold">Correo Electrónico</p>

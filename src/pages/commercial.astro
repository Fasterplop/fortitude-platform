---
import Layout from '../layouts/Layout.astro';
import Accordion from '../components/Accordion.astro';
import CarriersCarousel from '../components/CarriersCarousel.astro';
import { Image } from 'astro:assets';
import commercialImg from '../images/commercial.jpg';

// SEO Metadata (English - National Scope)
const title = "Commercial Insurance for Businesses | Fortitude Insurance";
const description = "Protect your business with custom coverage. Fast quotes for General Liability, Commercial Property, and more across the USA.";
const lang = "en";
---

<Layout title={title} description={description} lang={lang}>

  {/* 1. HERO (English Translation) */}
  <section class="relative pt-32 pb-20 lg:pt-40 lg:pb-28 overflow-hidden bg-surface-light dark:bg-surface-dark">
    <div class="container mx-auto px-4 relative z-10">
        <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-20">
            {/* Text & CTA */}
            <div class="lg:w-1/2 text-center lg:text-left">
                <span class="inline-block py-1 px-3 rounded-full bg-primary/10 text-primary text-xs font-bold uppercase tracking-widest mb-6">
                    Commercial Insurance
                </span>
                
                <h1 class="text-4xl md:text-5xl lg:text-6xl font-serif font-bold text-text-main dark:text-white mb-6 leading-[1.1]">
                    Solid solutions for <br/>
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-yellow-600">your business</span>
                </h1>
                
                <p class="text-lg text-gray-600 dark:text-gray-300 mb-8 max-w-xl mx-auto lg:mx-0 leading-relaxed">
                    We understand your business is the result of your effort. We offer insurance designed to mitigate risks and allow you to focus on growing.
                </p>
                
                <div class="flex flex-col sm:flex-row items-center gap-4 justify-center lg:justify-start">
                    {/* BUTTON TO OPEN MODAL */}
                    <button class="open-quote-modal w-full sm:w-auto px-8 py-4 bg-primary hover:bg-primary-hover text-text-main font-bold rounded-full transition-all shadow-lg hover:shadow-xl hover:-translate-y-1 text-lg flex items-center justify-center gap-2">
                        Quote my Business
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                    </button>
                    
                    <a href="/contact" class="w-full sm:w-auto px-8 py-4 border border-gray-200 dark:border-white/10 text-text-main dark:text-white font-medium rounded-full hover:bg-gray-50 dark:hover:bg-white/5 transition-colors text-center">
                        Speak with an Agent
                    </a>
                </div>

                <p class="mt-4 text-xs text-gray-500 dark:text-gray-400 flex items-center justify-center lg:justify-start gap-2">
                    <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    Free process with no impact on your business credit.
                </p>
            </div>

            {/* Hero Image */}
            <div class="lg:w-1/2 relative w-full">
                <div class="relative aspect-[4/3] rounded-3xl overflow-hidden shadow-2xl border border-white/20 group">
                    <Image src={commercialImg} alt="Protected business" class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105" />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div>
                </div>
            </div>
        </div>
    </div>
  </section>

  {/* 2. BENEFITS (Business Focused) */}
  <section class="py-16 bg-white dark:bg-[#0a0a0a] border-b border-gray-100 dark:border-white/5">
    <div class="container mx-auto px-4">
        <div class="grid md:grid-cols-3 gap-8 lg:gap-12">
            <div class="flex flex-col items-center text-center p-6 rounded-2xl bg-gray-50 dark:bg-white/5">
                <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center text-primary mb-4 text-2xl">
                    ⚡
                </div>
                <h3 class="text-xl font-bold text-text-main dark:text-white mb-2">Quoting Efficiency</h3>
                <p class="text-gray-600 dark:text-gray-400 text-sm">Time is money. Get a professional estimate in minutes so your commercial operation never stops.</p>
            </div>
            
            <div class="flex flex-col items-center text-center p-6 rounded-2xl bg-gray-50 dark:bg-white/5">
                <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center text-primary mb-4 text-2xl">
                    🛡️
                </div>
                <h3 class="text-xl font-bold text-text-main dark:text-white mb-2">Specialized Advice</h3>
                <p class="text-gray-600 dark:text-gray-400 text-sm">Our agents analyze your industry's specific risks to recommend the exact coverage you need.</p>
            </div>

            <div class="flex flex-col items-center text-center p-6 rounded-2xl bg-gray-50 dark:bg-white/5">
                <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center text-primary mb-4 text-2xl">
                    💰
                </div>
                <h3 class="text-xl font-bold text-text-main dark:text-white mb-2">Centralized Management</h3>
                <p class="text-gray-600 dark:text-gray-400 text-sm">Simplify your administration. Manage all your business policies from a single smart portal available 24/7.</p>
            </div>
        </div>
    </div>
  </section>

  {/* 3. DETAILED COVERAGES (English Accordions) */}
  <section class="py-24 bg-surface-light dark:bg-surface-dark">
      <div class="container mx-auto px-4 max-w-4xl">
          <div class="text-center mb-12">
              <h2 class="text-3xl font-serif font-bold text-text-main dark:text-white mb-4">Coverage designed for the modern enterprise</h2>
              <p class="text-gray-600 dark:text-gray-300">From small startups to corporations, our policies adapt to your industry.</p>
          </div>

          <div class="space-y-4">
              <Accordion 
                title="General Liability" 
                details="Essential protection against claims for bodily injury or property damage to third parties occurring during your operations. It is the first line of defense to protect your company's assets against unforeseen lawsuits or accidents on your premises." 
              />
              <Accordion 
                title="Commercial Property" 
                details="Safeguard your physical assets. This coverage protects your buildings, inventory, equipment, furniture, and tools against major risks such as fire, theft, vandalism, or natural disasters, ensuring the continuity of your operation." 
              />
              <Accordion 
                title="Commercial Auto" 
                details="Specialized coverage for vehicles used for business purposes. Ensures your fleet, drivers, and cargo are protected with adequate liability limits that a personal policy would not cover, including protection for employee vehicles." 
              />
              <Accordion 
                title="Workers' Compensation" 
                details="Comply with the law and protect your team. This coverage pays medical expenses and lost wages if an employee gets injured on the job, while also protecting your company from lawsuits related to workplace accidents." 
              />
          </div>
      </div>
  </section>

  {/* 4. TRUST BLOCK (Management Tools Focus) */}
  <section class="py-24 bg-gray-50 dark:bg-[#111]">
      <div class="container mx-auto px-4">
          <div class="flex flex-col lg:flex-row items-center gap-16">
              <div class="lg:w-1/2">
                  <h2 class="text-3xl md:text-4xl font-serif font-bold text-text-main dark:text-white mb-6">
                      Management tools for business owners
                  </h2>
                  <p class="text-gray-600 dark:text-gray-300 text-lg mb-8 leading-relaxed">
                      Time is your most valuable resource. That's why our client portal allows you to manage your documents without intermediaries.
                  </p>
                  
                  <div class="space-y-8">
                      <div class="flex gap-4">
                          <div class="w-12 h-12 rounded-full bg-primary flex items-center justify-center text-white font-bold text-xl shrink-0">1</div>
                          <div>
                              <h4 class="text-xl font-bold text-text-main dark:text-white mb-2">Instant Certificates (COI)</h4>
                              <p class="text-gray-600 dark:text-gray-400 text-sm">Get insurance certificates immediately to present to your clients or contractors and close deals faster.</p>
                          </div>
                      </div>
                       <div class="flex gap-4">
                          <div class="w-12 h-12 rounded-full bg-surface-light dark:bg-white/10 flex items-center justify-center text-text-main dark:text-white font-bold text-xl shrink-0 border border-gray-200 dark:border-gray-700">2</div>
                          <div>
                              <h4 class="text-xl font-bold text-text-main dark:text-white mb-2">Change Requests</h4>
                              <p class="text-gray-600 dark:text-gray-400 text-sm">Update your company details, add vehicles to your fleet, or adjust coverage as your business grows.</p>
                          </div>
                      </div>
                       <div class="flex gap-4">
                          <div class="w-12 h-12 rounded-full bg-surface-light dark:bg-white/10 flex items-center justify-center text-text-main dark:text-white font-bold text-xl shrink-0 border border-gray-200 dark:border-gray-700">3</div>
                          <div>
                              <h4 class="text-xl font-bold text-text-main dark:text-white mb-2">Document Access</h4>
                              <p class="text-gray-600 dark:text-gray-400 text-sm">Download digital copies of your policies, ID cards, and payment receipts at any time.</p>
                          </div>
                      </div>
                  </div>
              </div>
              
              {/* Stats Grid (NATIONAL COVERAGE) */}
              <div class="lg:w-1/2 relative">
                  <div class="grid grid-cols-2 gap-4">
                      <div class="bg-white dark:bg-white/5 p-6 rounded-2xl shadow-sm border border-gray-100 dark:border-white/5 text-center">
                          <div class="text-4xl font-bold text-primary mb-2">24/7</div>
                          <div class="text-sm text-gray-500 uppercase tracking-wider font-bold">Portal Access</div>
                      </div>
                       <div class="bg-white dark:bg-white/5 p-6 rounded-2xl shadow-sm border border-gray-100 dark:border-white/5 text-center">
                          <div class="text-4xl font-bold text-primary mb-2">COI</div>
                          <div class="text-sm text-gray-500 uppercase tracking-wider font-bold">Instant Issue</div>
                      </div>
                       {/* NATIONAL COVERAGE */}
                       <div class="bg-white dark:bg-white/5 p-6 rounded-2xl shadow-sm border border-gray-100 dark:border-white/5 text-center col-span-2">
                          <div class="text-4xl font-bold text-primary mb-2">USA</div>
                          <div class="text-sm text-gray-500 uppercase tracking-wider font-bold">National Coverage</div>
                      </div>
                  </div>
              </div>
          </div>
      </div>
  </section>

  {/* 5. CARRIERS */}
  <section class="py-20 bg-white dark:bg-black border-t border-gray-100 dark:border-white/10">
      <div class="container mx-auto px-4">
          <CarriersCarousel lang={lang} />
      </div>
  </section>

  {/* FINAL CTA */}
  <section class="py-20 bg-primary text-text-main text-center">
      <div class="container mx-auto px-4">
          <h2 class="text-3xl md:text-4xl font-serif font-bold mb-6">Ensure your business continuity</h2>
          <p class="text-xl mb-8 opacity-90 max-w-2xl mx-auto">Our expert agents are ready to design your protection plan.</p>
          <div class="flex justify-center gap-4">
               <button class="open-quote-modal px-8 py-4 bg-white text-text-main font-bold rounded-full shadow-lg hover:shadow-xl hover:-translate-y-1 transition-all">
                  Quote my Business
               </button>
          </div>
      </div>
  </section>

</Layout>
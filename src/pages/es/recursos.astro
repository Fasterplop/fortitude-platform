---
import Layout from '../../layouts/Layout.astro';
import InternalHero from '../../components/InternalHero.astro';
import Accordion from '../../components/Accordion.astro';
import { Image } from 'astro:assets';

// Imagen de fondo
import resourcesHeroImg from '../../images/property.jpg'; 

const title = "Recursos y Ayuda | Fortitude Insurance";
const description = "Herramientas de gestión, directorio de aseguradoras, guías de prevención y enlaces oficiales para Florida y Texas.";

// URL del Client Center (Centralizado)
const CLIENT_PORTAL = "https://customerservice.agentinsure.com/EzlynxCustomerService/fortitudeis/Account/LogIn";

// Datos del Directorio de Aseguradoras (Volvemos a las 4 principales para el Grid de 4 columnas)
const carriers = [
  { name: 'Progressive', phone: '1-800-776-4737', website: 'https://www.progressive.com', logo: '/images/carriers/Progressive.png' },
  { name: 'National General', phone: '1-877-468-3466', website: 'https://nationalgeneral.com', logo: '/images/carriers/NationalGeneral.png' },
  { name: 'Bristol West', phone: '1-800-274-7865', website: 'https://www.bristolwest.com', logo: '/images/carriers/Bristol.png' },
  { name: 'Geico', phone: '1-800-841-3000', website: 'https://www.geico.com', logo: '/images/carriers/Geico.png' },
];


// Consejos de Prevención
const preventionTips = [
    { 
        icon: "🏠", 
        title: "Prepara tu Casa para Huracanes", 
        desc: "Revisar el techo y asegurar ventanas no solo protege tu hogar, sino que puede generarte grandes descuentos en tu póliza de propiedad (Wind Mitigation Credit)." 
    },
    { 
        icon: "🚘", 
        title: "Conductores Adolescentes", 
        desc: "Inscribir a tus hijos en cursos de manejo defensivo y mantener buenas calificaciones escolares puede reducir significativamente el impacto en tu prima." 
    },
    { 
        icon: "💧", 
        title: "Prevención de Daños por Agua", 
        desc: "El daño por agua es el reclamo más común en Florida. Instalar sensores de fugas y conocer dónde está la llave de paso principal es vital." 
    }
];
---

<Layout title={title} description={description} lang="es">

  {/* 1. HERO: Enfoque en Servicio */}
  <InternalHero
    title="Centro de Recursos y Soporte"
    subtitle="Todo lo que necesitas para gestionar tu póliza, prevenir riesgos y actuar en caso de emergencia, en un solo lugar."
    image={resourcesHeroImg}
    imageAlt="Protección y seguridad"
  />

  {/* 2. ACCIONES RÁPIDAS (Portal de Cliente) */}
  <section class="relative z-20 -mt-16 px-4 pb-16">
    <div class="container mx-auto">
        <div class="bg-white dark:bg-[#151515] rounded-3xl p-8 md:p-12 shadow-2xl border border-gray-100 dark:border-white/5 flex flex-col md:flex-row items-center gap-8 md:gap-12">
            
            <div class="md:w-2/3">
                <div class="flex items-center gap-3 mb-4">
                    <span class="inline-block py-1 px-3 rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 text-xs font-bold uppercase tracking-widest">
                        Gestión 24/7
                    </span>
                    <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
                </div>
                <h2 class="text-3xl font-serif font-bold text-text-main dark:text-white mb-4">
                    Tu Portal de Cliente
                </h2>
                <p class="text-gray-600 dark:text-gray-300 text-lg leading-relaxed mb-6">
                    Olvídate de las esperas telefónicas. Gestiona tu seguro de forma autónoma, segura y desde cualquier dispositivo.
                </p>
                <div class="grid sm:grid-cols-2 gap-4 mb-8">
                    <div class="flex items-start gap-3">
                        <div class="p-2 bg-primary/10 rounded-lg text-primary">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2"></path></svg>
                        </div>
                        <div>
                            <p class="font-bold text-text-main dark:text-white">ID Cards Digitales</p>
                            <p class="text-xs text-gray-500">Descarga y muestra a la policía desde tu móvil.</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-3">
                        <div class="p-2 bg-primary/10 rounded-lg text-primary">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
                        </div>
                        <div>
                            <p class="font-bold text-text-main dark:text-white">Pagos Seguros</p>
                            <p class="text-xs text-gray-500">Evita cancelaciones por olvido.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="md:w-1/3 w-full flex flex-col gap-4">
                <a href={CLIENT_PORTAL} target="_blank" class="w-full py-4 bg-primary hover:bg-primary-hover text-text-main font-bold rounded-xl shadow-lg hover:shadow-xl transition-all hover:-translate-y-1 text-center flex items-center justify-center gap-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path></svg>
                    Entrar al Portal
                </a>
                <p class="text-xs text-center text-gray-400">
                    ¿Es tu primera vez? <a href="/es/contacto" class="underline hover:text-primary">Solicita tu acceso aquí</a>
                </p>
            </div>

        </div>
    </div>
  </section>

  {/* 3. LÍNEA DE TIEMPO DEL RECLAMO (Educativo) */}
  <section class="py-20 bg-gray-50 dark:bg-[#0a0a0a]">
      <div class="container mx-auto px-4">
          <div class="text-center mb-16">
              <h2 class="text-3xl font-serif font-bold text-text-main dark:text-white mb-4">¿Cómo funciona un Reclamo?</h2>
              <p class="text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">Saber qué esperar reduce la ansiedad. Aquí te explicamos el proceso paso a paso.</p>
          </div>

          <div class="relative">
              {/* Línea conectora (Desktop) */}
              <div class="hidden md:block absolute top-1/2 left-0 w-full h-1 bg-gray-200 dark:bg-white/10 -translate-y-1/2 z-0"></div>
              
              <div class="grid grid-cols-1 md:grid-cols-4 gap-8 relative z-10">
                  {/* Pasos 1-4 */}
                  {[
                      { step: 1, title: "Reporte", desc: "Contactas a la aseguradora (o a nosotros) para notificar el incidente. Obtienes un número de reclamo." },
                      { step: 2, title: "Ajustador", desc: "Un ajustador te contactará para inspeccionar los daños (vehículo o propiedad) y revisar la cobertura." },
                      { step: 3, title: "Estimado", desc: "Se aprueba el presupuesto de reparación. Si es auto, puede ser en un taller de la red de la aseguradora." },
                      { step: 4, title: "Resolución", desc: "La aseguradora emite el pago (a ti o al taller/contratista) menos tu deducible aplicable." }
                  ].map((item, index) => (
                      <div class="bg-white dark:bg-[#151515] p-6 rounded-xl border border-gray-100 dark:border-white/5 shadow-lg text-center relative group hover:-translate-y-2 transition-transform duration-300">
                          <div class="w-12 h-12 bg-gray-200 dark:bg-white/20 text-gray-700 dark:text-white rounded-full flex items-center justify-center text-xl font-bold mx-auto mb-4 border-4 border-white dark:border-[#151515] group-hover:bg-primary group-hover:text-white transition-colors">
                              {item.step}
                          </div>
                          <h3 class="font-bold text-lg mb-2 text-text-main dark:text-white">{item.title}</h3>
                          <p class="text-sm text-gray-500">{item.desc}</p>
                      </div>
                  ))}
              </div>
          </div>
      </div>
  </section>

  {/* 4. DIRECTORIO DE ASEGURADORAS (RESTAURADO A 4 CARDS) */}
  <section class="py-20 bg-white dark:bg-[#111]">
      <div class="container mx-auto px-4">
          <div class="text-center max-w-3xl mx-auto mb-16">
              <h2 class="text-3xl md:text-4xl font-serif font-bold text-text-main dark:text-white mb-4">
                  Contactos Directos de Aseguradoras
              </h2>
              <p class="text-gray-600 dark:text-gray-300">
                  ¿Tienes una emergencia fuera de horario de oficina? Contacta directamente al departamento de reclamos de tu compañía.
              </p>
          </div>

          {/* GRID DE 4 COLUMNAS (Como estaba antes) */}
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
              {carriers.map(carrier => (
                  <div class="bg-white dark:bg-[#151515] p-6 rounded-2xl shadow-sm border border-gray-100 dark:border-white/5 hover:border-primary/30 transition-all group">
                      <div class="h-12 mb-6 flex items-center justify-start">
                          <img src={carrier.logo} alt={carrier.name} class="h-full w-auto object-contain dark:brightness-0 dark:invert opacity-80 group-hover:opacity-100 transition-opacity" />
                      </div>
                      
                      <h3 class="font-bold text-lg text-text-main dark:text-white mb-4">{carrier.name}</h3>
                      
                      <div class="space-y-3">
                          <a href={`tel:${carrier.phone}`} class="flex items-center gap-3 text-gray-600 dark:text-gray-400 hover:text-primary transition-colors bg-gray-50 dark:bg-white/5 p-3 rounded-lg border border-gray-100 dark:border-white/5 hover:bg-white dark:hover:bg-white/10">
                              <div class="w-8 h-8 rounded-full bg-white dark:bg-white/10 flex items-center justify-center text-primary shadow-sm">
                                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                              </div>
                              <span class="text-sm font-bold">Llamar a Reclamos</span>
                          </a>
                          
                          <a href={carrier.website} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-gray-500 hover:text-primary transition-colors p-2 pl-3 text-sm">
                              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                              Sitio Web Oficial
                          </a>
                      </div>
                  </div>
              ))}
          </div>
          
          <div class="mt-12 text-center">
            <p class="text-sm text-gray-500 italic">
                * Si tu aseguradora no aparece aquí, por favor inicia sesión en el Portal de Cliente.
            </p>
          </div>
      </div>
  </section>

  {/* 5. PREVENCIÓN E INFORMACIÓN (Sección Extendida) */}
  <section class="py-20 bg-gray-50 dark:bg-[#0a0a0a] overflow-hidden">
      <div class="container mx-auto px-4">
          <div class="flex flex-col lg:flex-row gap-16">
              
              {/* Columna Izquierda: Prevención y Enlaces */}
              <div class="lg:w-1/2">
                  <h3 class="text-2xl font-serif font-bold text-text-main dark:text-white mb-8 flex items-center gap-3">
                      <span class="w-10 h-10 rounded-full bg-yellow-100 dark:bg-yellow-900/20 flex items-center justify-center text-yellow-600">
                          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                      </span>
                      Prevención y Ahorro
                  </h3>
                  <div class="space-y-6">
                      {preventionTips.map(tip => (
                          <div class="flex gap-5">
                              <div class="w-12 h-12 rounded-xl bg-white dark:bg-white/5 border border-gray-200 dark:border-white/10 flex items-center justify-center text-2xl shadow-sm flex-shrink-0">
                                  {tip.icon}
                              </div>
                              <div>
                                  <h4 class="font-bold text-lg text-text-main dark:text-white mb-2">{tip.title}</h4>
                                  <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">
                                      {tip.desc}
                                  </p>
                              </div>
                          </div>
                      ))}
                  </div>
                  
                 
              </div>

              {/* Columna Derecha: Diccionario de Seguros */}
              <div class="lg:w-1/2">
                  <h3 class="text-2xl font-serif font-bold text-text-main dark:text-white mb-8 flex items-center gap-3">
                      <span class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary">
                          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
                      </span>
                      Diccionario de Seguros
                  </h3>
                  <div class="space-y-4">
                      <Accordion 
                          title="¿Qué es el Deducible?" 
                          details="Es la cantidad de dinero que tú debes pagar de tu bolsillo antes de que la aseguradora cubra el resto de los daños. Por ejemplo, si tienes un daño de $2,000 y tu deducible es de $500, la aseguradora pagará $1,500. Elegir un deducible más alto suele bajar tu pago mensual." 
                      />
                      <Accordion 
                          title="¿Qué es PIP (Personal Injury Protection)?" 
                          details="En Florida es obligatorio. Cubre el 80% de tus gastos médicos y el 60% de salarios perdidos si tienes un accidente, sin importar quién tuvo la culpa (No-Fault Law). El límite estándar es $10,000." 
                      />
                      <Accordion 
                          title="¿Responsabilidad Civil (Liability)?" 
                          details="Es la cobertura que paga por los daños que tú le causes a otras personas (sus autos o su salud) en un accidente donde tú tuviste la culpa. No cubre tus propios daños." 
                      />
                      <Accordion 
                          title="¿Comprehensive vs Collision?" 
                          details="'Collision' cubre choques contra otros autos u objetos. 'Comprehensive' cubre daños que NO son choques: robo, fuego, vandalismo, granizo, inundación o golpe contra un animal." 
                      />
                      <Accordion 
                          title="¿Qué es el Wind Mitigation?" 
                          details="Es una inspección para viviendas en Florida que certifica qué tan resistente es tu techo y ventanas contra huracanes. Tenerla actualizada puede ahorrarte miles de dólares en tu seguro de hogar." 
                      />
                  </div>
              </div>

          </div>
      </div>
  </section>

  {/* CTA FINAL */}
  <section class="py-16 bg-primary text-text-main text-center">
      <div class="container mx-auto px-4">
          <h2 class="text-3xl font-bold mb-4">¿Tienes una duda específica?</h2>
          <p class="mb-8 opacity-90 text-lg max-w-2xl mx-auto">
              A veces la teoría no es suficiente. Habla con un agente real que conoce tu póliza al detalle.
          </p>
          <div class="flex justify-center gap-4 flex-col sm:flex-row">
            <a href="/es/contacto" class="inline-block px-8 py-4 bg-white text-text-main font-bold rounded-full shadow-lg hover:bg-gray-100 transition-all hover:-translate-y-1">
                Contactar a un Agente
            </a>
            <a href="tel:813-753-4197" class="inline-block px-8 py-4 bg-black/10 text-white font-bold rounded-full hover:bg-black/20 transition-all">
                Llamar Ahora
            </a>
          </div>
      </div>
  </section>

</Layout>
---
import Layout from '../layouts/Layout.astro';

const title = "Terms & Conditions | Fortitude Insurance";
const description = "Terms of use, liability limitations, and legal conditions for using Fortitude Insurance Services LLC services.";

// Last updated date
const lastUpdated = "February 1, 2026";
---

<Layout title={title} description={description} lang="en">

  {/* SIMPLE HEADER (Text Only) */}
  <section class="pt-32 pb-12 bg-surface-light dark:bg-[#050505]">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-5xl font-serif font-bold text-text-main dark:text-white mb-4">
        Terms & Conditions
      </h1>
      <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
        Please read our terms of use carefully before using our services.
      </p>
    </div>
  </section>

  {/* LEGAL CONTENT */}
  <section class="pb-20 bg-surface-light dark:bg-[#050505]">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto bg-white dark:bg-[#151515] p-8 md:p-12 rounded-3xl border border-gray-100 dark:border-white/5 shadow-xl">
        
        {/* Intro */}
        <div class="mb-10 pb-10 border-b border-gray-100 dark:border-white/10">
            <p class="text-sm text-gray-500 dark:text-gray-400 mb-4 font-mono uppercase tracking-widest">
                Last Updated: {lastUpdated}
            </p>
            <p class="text-lg text-gray-700 dark:text-gray-300 leading-relaxed">
                Welcome to <strong>Fortitude Insurance Services LLC</strong> ("Agency", "we", "our"). By accessing our website, using our online quoter, or engaging our services, you agree to be legally bound by the following terms and conditions.
            </p>
        </div>

        {/* Clauses */}
        <div class="space-y-12 text-gray-700 dark:text-gray-300 leading-relaxed">

            {/* 1. Nature of Services */}
            <article>
                <h3 class="text-2xl font-serif font-bold text-text-main dark:text-white mb-4">
                    1. Nature of Services
                </h3>
                <p>
                    Fortitude Insurance operates as an <strong>independent insurance agency</strong> licensed in the states of Florida and Texas. We are not an insurance carrier. We act as intermediaries to solicit quotes, present options, and facilitate policy issuance between you (the client) and insurance carriers (third parties).
                </p>
            </article>

            {/* 2. NO BINDING (Normalized Style) */}
            <article>
                <h3 class="text-2xl font-serif font-bold text-text-main dark:text-white mb-4">
                    2. No Automatic Coverage (No Binding)
                </h3>
                <p>
                    Use of our website, submission of contact forms, emails, voicemails, or obtaining an online quote <strong>does NOT constitute an insurance coverage agreement</strong> (binder).
                </p>
                <p class="mt-4">
                    No insurance coverage is considered in force, bound, changed, or renewed until you receive <strong>express written confirmation</strong> (Binder or Declarations Page) directly from a licensed agent of Fortitude Insurance or the respective insurance carrier.
                </p>
            </article>

            {/* 3. Information Accuracy */}
            <article>
                <h3 class="text-2xl font-serif font-bold text-text-main dark:text-white mb-4">
                    3. Information Accuracy
                </h3>
                <p>
                    Quotes presented are strictly based on the information you provide. You are responsible for ensuring that all data (driving history, vehicle usage, property details, etc.) is accurate and truthful.
                </p>
                <ul class="list-disc pl-5 mt-4 space-y-2 opacity-90">
                    <li>Omission or falsification of data may result in an inaccurate premium change.</li>
                    <li>Insurers reserve the right to cancel the policy or deny a claim if false information ("Material Misrepresentation") is discovered.</li>
                </ul>
            </article>

            {/* 4. Third-Party Links */}
            <article>
                <h3 class="text-2xl font-serif font-bold text-text-main dark:text-white mb-4">
                    4. Third-Party Links & Services
                </h3>
                <p>
                    Our website may contain links to external sites, including insurer payment portals (Progressive, Geico, etc.) or quoting systems (EZLynx). Fortitude Insurance does not control or guarantee the content, privacy policies, or security of these third-party sites.
                </p>
            </article>

            {/* 5. Intellectual Property */}
            <article>
                <h3 class="text-2xl font-serif font-bold text-text-main dark:text-white mb-4">
                    5. Intellectual Property
                </h3>
                <p>
                    All content on this website, including logos, text, designs, and code, is the property of Fortitude Insurance Services LLC or used under license. Insurer logos displayed belong to their respective owners and are used solely for informational purposes to identify our business partners.
                </p>
            </article>

            {/* 6. Limitation of Liability */}
            <article>
                <h3 class="text-2xl font-serif font-bold text-text-main dark:text-white mb-4">
                    6. Limitation of Liability
                </h3>
                <p>
                    To the maximum extent permitted by applicable law, Fortitude Insurance shall not be liable for any direct, indirect, incidental, or consequential damages arising from the use or inability to use this website or the information provided herein.
                </p>
            </article>

            {/* 7. Governing Law */}
            <article>
                <h3 class="text-2xl font-serif font-bold text-text-main dark:text-white mb-4">
                    7. Jurisdiction & Governing Law
                </h3>
                <p>
                    These terms shall be governed by and interpreted in accordance with the laws of the <strong>State of Florida</strong>. Any legal dispute related to these terms shall be resolved exclusively in the competent courts of Pasco County, Florida.
                </p>
            </article>

            {/* Contact */}
            <div class="mt-16 pt-8 border-t border-gray-100 dark:border-white/10">
                <h4 class="font-bold text-lg text-text-main dark:text-white mb-2">Legal Questions?</h4>
                <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">
                    If you have questions about these terms, please contact us formally:
                </p>
                <address class="not-italic text-gray-700 dark:text-gray-300">
                    <strong>Fortitude Insurance Services LLC</strong><br/>
                    28210 Paseo Drive #190<br/>
                    Wesley Chapel, FL 33543<br/>
                    <a href="mailto:support@fortitudeins.us" class="text-primary hover:underline">support@fortitudeins.us</a>
                </address>
            </div>

        </div>
      </div>
    </div>
  </section>

</Layout>